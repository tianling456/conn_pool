<?xml version="1.0" encoding="UTF-8"?>
<mappers>
    <mapper namespace="user" default-datasource="master">
        <sql id="userColumns">id, name, age</sql>
        <sql id="userBase">SELECT <include refid="userColumns"/> FROM user</sql>

        <resultMap id="userMap" type="User">
            <result column="id" property="id"/>
            <result column="name" property="name"/>
            <result column="age" property="age"/>
        </resultMap>

        <!-- 读走从库，只读事务 -->
        <select id="selectUserById" resultMap="userMap"
                tx-propagation="SUPPORTS" tx-read-only="true">
            <include refid="userBase"/> WHERE id = #{id}
        </select>

        <select id="selectAll" resultMap="userMap"
                tx-propagation="SUPPORTS" tx-read-only="true">
            <include refid="userBase"/> ORDER BY id
        </select>

        <select id="selectUsersByCondition" datasource="slave" resultMap="userMap"
                tx-propagation="SUPPORTS" tx-read-only="true">
            <include refid="userBase"/>
            <where>
                <if test="name != null and name != ''">AND name LIKE CONCAT('%', #{name}, '%')</if>
                <if test="minAge != null">AND age &gt;= #{minAge}</if>
                <if test="maxAge != null">AND age &lt;= #{maxAge}</if>
            </where>
            <if test="orderBy != null">ORDER BY ${orderBy}</if>
            <if test="limit != null">LIMIT #{limit}</if>
        </select>

        <select id="selectByStatus">
            SELECT id, name FROM user
            <choose>
                <when test="status == 1">WHERE active = 1</when>
                <when test="status == 0">WHERE active = 0</when>
                <otherwise>WHERE active = 1</otherwise>
            </choose>
        </select>

        <select id="selectByNameLike">
            <bind name="pattern" value="'%' + name + '%'"/>
            SELECT id, name FROM user WHERE name LIKE #{pattern}
        </select>

        <!-- 写走主库，默认事务，声明隔离级别和超时 -->
        <insert id="insertUser"
                tx-propagation="REQUIRED" tx-isolation="READ_COMMITTED" tx-timeout-sec="5">
            <selectKey order="AFTER" keyProperty="id" resultType="int64">
                SELECT LAST_INSERT_ID()
            </selectKey>
            INSERT INTO user(name, age) VALUES(#{name}, #{age})
        </insert>

        <update id="updateUserName"
                tx-propagation="REQUIRED" tx-isolation="READ_COMMITTED">
            UPDATE user
            <set>
                <if test="name != null">name = #{name},</if>
                <if test="age  != null">age  = #{age},</if>
            </set>
            WHERE id = #{id}
        </update>

        <delete id="deleteUser" tx-propagation="REQUIRED">
            DELETE FROM user WHERE id = #{id}
        </delete>

        <insert id="batchInsertUsers" tx-propagation="REQUIRED">
            INSERT INTO user(name, age) VALUES
            <foreach collection="users" item="u" separator=",">
                (#{u.name}, #{u.age})
            </foreach>
        </insert>

        <ddl id="createUserTable">
            CREATE TABLE IF NOT EXISTS user (
            id BIGINT PRIMARY KEY AUTO_INCREMENT,
            name VARCHAR(64) NOT NULL,
            age INT NOT NULL DEFAULT 0
            )
        </ddl>
        <dcl id="grantRead">GRANT SELECT ON app_db.* TO 'reader'@'%'</dcl>
    </mapper>
</mappers>